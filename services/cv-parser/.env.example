# Bind address — 0.0.0.0 so Docker containers can reach the host sidecar
CV_PARSER_HOST=0.0.0.0
CV_PARSER_PORT=5101

# Shared secret (must match backend CV_PARSER_SERVICE_TOKEN)
CV_PARSER_SERVICE_TOKEN=change-me

# Waitress worker threads
CV_PARSER_THREADS=4

# Optional: absolute path to venv python when using ecosystem.config.cjs
# CV_PARSER_PYTHON=/var/www/cari-kerja/be-stage-cari-kerja/.venv-cv/bin/python
