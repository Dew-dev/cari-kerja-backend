# Application
APP_HOST=http://localhost
APP_ENV=development
APP_PORT=5002
FE_URL=http://localhost:5173

# CV Parsing AI (OpenAI-compatible Chat Completions endpoint)
# Leave these empty to use the local heuristic fallback parser.
CV_PARSER_AI_URL=https://api.openai.com/v1/chat/completions
CV_PARSER_AI_KEY=your-api-key
CV_PARSER_AI_MODEL=gpt-4o-mini

# Gemini option 1 (OpenAI-compatible):
# CV_PARSER_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CV_PARSER_AI_KEY=your-gemini-api-key
# CV_PARSER_AI_MODEL=gemini-2.0-flash

# Gemini option 2 (Native REST generateContent):
# CV_PARSER_AI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
# CV_PARSER_AI_KEY=your-gemini-api-key
# CV_PARSER_AI_MODEL=gemini-2.0-flash

# Python resume parser bridge (scripts/cv_parse_python.py)
# Uses pip package resume-parser when compatible; otherwise spaCy + pdfplumber/docx2txt fallback.
# Requires: python on PATH (or set CV_PYTHON_BIN), plus: spacy, pdfplumber, docx2txt, en_core_web_sm
CV_USE_PYTHON_RESUME_PARSER=false
CV_PYTHON_BIN=python
# CV_PYTHON_PARSER_SCRIPT=scripts/cv_parse_python.py
# CV_PYTHON_PARSER_TIMEOUT_MS=60000

# Optional npm resume-parser layer before NLP fallback
# Set true to enable package `resume-parser` (requires host binaries like pdftotext/catdoc for best results).
CV_USE_RESUME_PARSER=false

# OpenResume-style PDF parser layer (uses pdfjs text-item + line/section grouping)
# Default: on. Automatically skipped when CV_USE_PYTHON_RESUME_PARSER=true unless set true.
# Set false to disable entirely.
CV_USE_OPENRESUME_STYLE=false

# Hybrid OCR for scanned/image PDFs (digital text → Tesseract → optional Vision)
# Set false to disable OCR entirely and rely on embedded PDF text only.
CV_OCR_ENABLED=true
CV_OCR_LANGS=eng+ind
CV_OCR_MIN_CHARS=80
CV_OCR_MAX_PAGES=3
CV_OCR_RENDER_SCALE=2

# Optional Vision OCR fallback (fill when API key is ready)
# OpenAI-compatible example:
# CV_OCR_VISION_URL=https://api.openai.com/v1/chat/completions
# CV_OCR_VISION_KEY=your-api-key
# CV_OCR_VISION_MODEL=gpt-4o-mini
#
# Gemini OpenAI-compatible:
# CV_OCR_VISION_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CV_OCR_VISION_KEY=your-gemini-api-key
# CV_OCR_VISION_MODEL=gemini-2.0-flash
#
# Gemini native generateContent:
# CV_OCR_VISION_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
# CV_OCR_VISION_KEY=your-gemini-api-key
# CV_OCR_VISION_MODEL=gemini-2.0-flash
CV_OCR_VISION_URL=
CV_OCR_VISION_KEY=
CV_OCR_VISION_MODEL=gpt-4o-mini

# CORS
CORS_ORIGIN=http://example1.com,http://example2.com

# Database
POSTGRESQL_URL=postgresql://postgres:postgres@localhost:5432/sample

# JWT Secret
ACCESS_TOKEN_SECRET=your-key
REFRESH_TOKEN_SECRET=your-key
ACCESS_SIGN_OPTIONS='{"expiresIn": "5m"}'
REFRESH_SIGN_OPTIONS='{"expiresIn": "1d"}'

# BASIC AUTH
USERNAME_BASIC=your_basic
PASSWORD_BASIC=your_basic

# GOOGLE OAUTH 2.0
GOOGLE_CLIENT_ID=your_id
GOOGLE_SECRET_KEY=your_secret

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Object Storage
R2_ENDPOINT_S3_CLIENT=your_endpoint_s3
R2_USER_API_TOKEN=your_token
R2_ACCESS_S3_USER=your_user
R2_SECRET_S3_USER=your_secret
R2_BUCKET_NAME=your-bucket-name

# Mail Configuration
MAIL_HOST=your-host
MAIL_PORT=your-port
MAIL_SECURE=true
MAIL_FROM=your-mail-from
MAIL_USER=your-mail
MAIL_PASS=your-mail-pw

# Encryption Data
ENCRYPTION_KEY=your-key

# Xendit Payment Gateway
# Dapatkan dari: https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token
XENDIT_CALLBACK_URL=https://your-backend.com/api/v1/payments/webhook/xendit
XENDIT_SUCCESS_REDIRECT_URL=https://your-frontend.com/payment/success
XENDIT_FAILURE_REDIRECT_URL=https://your-frontend.com/payment/failed

# Cloudflare Turnstile (CAPTCHA) — kosongkan di local untuk skip verifikasi
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Smart Candidate Matching (hybrid semantic + rules)
# MATCHING_ENABLED=false to disable enqueue/compute
MATCHING_ENABLED=true
MATCHING_MODEL_VERSION=hybrid-v1
# Optional external embedding HTTP API. Empty → local bag-of-words fallback.
MATCHING_EMBEDDING_URL=
MATCHING_EMBEDDING_API_KEY=
MATCHING_W_SEMANTIC=0.50
MATCHING_W_SKILLS=0.25
MATCHING_W_EXPERIENCE=0.15
MATCHING_W_EDUCATION=0.10
# Vector dims must match embedding model (local BoW default = 256)
MATCHING_EMBEDDING_DIMS=256

# Phase B: Elasticsearch dense_vector (optional). Keep false for local Phase A only.
MATCHING_ES_ENABLED=false
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
MATCHING_ES_JOBS_INDEX=matching_jobs
MATCHING_ES_WORKERS_INDEX=matching_workers
MATCHING_ES_KNN_CANDIDATES=50

# TELEGRAM OIDC AUTH
TELEGRAM_CLIENT_ID=your_telegram_client_id
TELEGRAM_CLIENT_SECRET=your_telegram_client_secret
TELEGRAM_REDIRECT_URI=http://localhost:5002/api/v1/users/telegram/callback